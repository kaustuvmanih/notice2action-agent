# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Logging & Environment
LOG_LEVEL=INFO
APP_ENV=production

# Fallback & Offline Execution:
# When true or when GEMINI_API_KEY is not set, the deterministic offline fallback engine will be used.
ENABLE_FALLBACK=true
